{
  "name": "@streakly/server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "check": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json --noEmit false",
    "start": "node --env-file-if-exists=.env dist/server/src/server.js",
    "test": "NODE_ENV=test node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "mongoose": "^9.12.1",
    "nodemailer": "^10.5.0",
    "sanitize-html": "^2.18.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2"
  }
}
