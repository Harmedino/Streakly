{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "../dist-server",
    "types": ["node"],
    "noEmit": true
  },
  "include": ["./**/*.ts", "../src/app/core/**/*.ts", "../src/app/models/**/*.ts"],
  "exclude": ["../src/**/*.spec.ts"]
}
