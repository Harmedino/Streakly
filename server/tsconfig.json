{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "..",
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "../client/src/app/core/utils/**/*.ts",
    "../client/src/app/core/models/**/*.ts"
  ],
  "exclude": ["../client/src/**/*.spec.ts"]
}
