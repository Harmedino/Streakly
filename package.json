{
  "name": "streakly",
  "version": "0.0.0",
  "scripts": {
    "ng": "npm run ng --workspace client --",
    "start": "npm run start --workspace client --",
    "build": "npm run build --workspace client",
    "watch": "npm run watch --workspace client",
    "test": "npm run test --workspace client --",
    "lint": "node scripts/check-structure.mjs && npm run server:check",
    "format": "prettier --write client/src server/src e2e README.md",
    "server": "npm run dev --workspace server",
    "server:check": "npm run check --workspace server",
    "server:build": "npm run build --workspace server",
    "server:start": "npm run start --workspace server",
    "test:api": "npm run test --workspace server",
    "test:e2e": "playwright test",
    "test:pwa": "npm run build && playwright test --config playwright.pwa.config.ts",
    "test:backend:e2e": "playwright test --config playwright.backend.config.ts"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {},
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "workspaces": [
    "client",
    "server"
  ]
}
